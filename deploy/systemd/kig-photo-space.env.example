NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/kig-photo-space
PUBLIC_ORIGIN=https://photos.example.com
AUTH_PEPPER=replace-with-32-or-more-random-bytes-base64
COOKIE_SECURE=true
SESSION_TTL_DAYS=7
SESSION_MAX_DAYS=30
MAX_FULL_BYTES=52428800
MAX_THUMB_BYTES=2097152
MAX_PREVIEW_BYTES=8388608
MAX_IMAGE_DIMENSION=12000
PREVIEW_MAX_DIMENSION=3000
MAX_IMAGE_PIXELS=80000000
MAX_UPLOAD_FILES=50
UPLOAD_CONCURRENCY=2
MAX_TOTAL_BYTES=21474836480
MIN_FREE_BYTES=1073741824
TRASH_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=180
TRUST_PROXY=true
LOG_LEVEL=info
