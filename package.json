{
  "name": "kig-photo-space",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private photo sharing site for weak servers: browser-side AVIF transcoding, server stores AVIF + SQLite only.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm build && node --watch dist/server/index.js",
    "build": "pnpm build:server && pnpm build:client && node scripts/precompress.mjs",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "build:client": "vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "create-admin": "node dist/scripts/create-admin.js",
    "backup": "node dist/scripts/backup.js",
    "purge-trash": "node dist/scripts/purge-trash.js",
    "fsck": "node dist/scripts/fsck.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.2.1",
    "@phenomen/libavif-wasm": "^1.4.203",
    "exifr": "^7.1.3",
    "fastify": "^5.6.1",
    "hash-wasm": "^4.12.0",
    "libheif-js": "^1.23.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "playwright-core": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
